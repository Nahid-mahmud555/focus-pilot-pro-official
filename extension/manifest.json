{
  "manifest_version": 3,
  "name": "Focus Pilot Pro",
  "version": "1.1",
  "description": "Automatic Task Manager & Tab Opener 💻",
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Focus Pilot Pro",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "scripting",
    "activeTab"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "focus-pilot-pro@pandalab.local",
      "strict_min_version": "109.0"
    }
  }
}
